# SP-API 凭证模板 —— 复制本文件为 <项目工作区>/.env 并填入真实值
# ⚠️ 含机密，不提交 git / 不进聊天 / 不截图。放在「项目工作区」(默认 amazon-dev)
# 安全：开发用沙盒凭证；文件放在关联卖家后台的电脑上

SP_API_CLIENT_ID=你的client_id
SP_API_CLIENT_SECRET=你的client_secret
SP_API_REFRESH_TOKEN=你的refresh_token

# 区域 na(北美)/eu(欧洲)/fe(远东·日本/新加坡/澳洲)。中国卖家常用 fe
SP_API_REGION=fe

# 沙盒/生产开关（重要！）
#   true  = 走 SP-API Sandbox 沙盒（测试环境，返回 mock 数据，不碰真实店铺；用沙盒凭证）
#   false = 走生产环境（真实店铺数据；用生产凭证，注意 IP 关联风控与限流）
#   ⚠️ 强烈建议：开发/测试用 true，自测通过后再切 false。缺省/不设置 = 生产。
SP_API_SANDBOX=true

# 可选：marketplace id（多个逗号分隔），拉订单/库存/定价等用
# 常用参考（精确值以你店铺 Sellers.getMarketplaceParticipations 为准）：
#   美国 ATVPDKIKX0DER / 英国 A1F83G8C2ARO7P / 德国 A1PA6795UKMFR9
#   法国 A13V1IB3VIYZZH / 意大利 APJ6JRA9NG5V4 / 西班牙 A1RKKUPIHCS9HS
#   日本 A1VC38T7YXB528 / 加拿大 A2EUQ1WTGCTBG2 / 墨西哥 A1AM78C64UM0Y8
SP_API_MARKETPLACE_IDS=A1VC38T7YXB528

# 可选：其它进阶项（一般不需要）
# SPAPI_ENV_FILE=/path/to/.env       # 指定 .env 路径（默认自动找）
# SPAPI_MCP_PATH=/path/to/mcp        # 指定 sp-api-dev-mcp 包路径
