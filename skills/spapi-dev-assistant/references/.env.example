# SP-API 凭证模板 —— 复制本文件为 <项目工作区>/.env 并填入真实值
# ⚠️ 含机密，不提交 git / 不进聊天 / 不截图。放在「项目工作区」(默认 amazon-dev)
# 安全：开发用沙盒凭证；文件放在关联卖家后台的电脑上

SP_API_CLIENT_ID=你的client_id
SP_API_CLIENT_SECRET=你的client_secret
SP_API_REFRESH_TOKEN=你的refresh_token

# 区域 na(北美)/eu(欧洲)/fe(远东·日本/新加坡/澳洲)。中国卖家常用 fe
SP_API_REGION=fe

# 可选：你的 marketplace id（多个逗号分隔），拉订单等用
SP_API_MARKETPLACE_IDS=A1VC38T7YXB528
